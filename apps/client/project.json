{
  "name": "client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/client/src",
  "projectType": "application",
  "tags": ["scope:client", "type:app"],
  "// targets": "to see all targets run: nx show project client --web",
  "targets": {
    "test": {
      "//": "Vitest roda da raiz: os globs do vitest.config.ts sao relativos ao workspace.",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "vitest run --config apps/client/vitest.config.ts"
      },
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": []
    }
  }
}
