# Copy to `apps/client/.env` for local development. That file is gitignored.
#
# Expo inlines every EXPO_PUBLIC_* var into the bundle AT BUILD TIME, so these
# are not runtime config: whatever is set when `expo export` runs is what ships.
# Anything the production web build needs must therefore also be passed by
# .github/workflows/deploy.yml — a var that exists only here is a var that is
# missing in production.
#
# "Publishable" keys are public by design (they end up in a client bundle a
# user can read). Never put a real secret in an EXPO_PUBLIC_* var.

# --- Shipped to production (mirrored in deploy.yml) ---

# logo.dev publishable key, used by features/sections/lib/company-logo.ts to
# build company logo URLs. Without it `companyLogoUrl` returns undefined and
# every company logo silently disappears.
EXPO_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=pk_replace_me

# --- Development only (never set in the production build) ---

# Prefills auth forms. Gated on __DEV__ as well, so it is inert in a
# production bundle even if it leaks in — but keep it out anyway.
EXPO_PUBLIC_DEV_TEST_FILL=true
# EXPO_PUBLIC_DEV_TEST_EMAIL=test@example.com
# EXPO_PUBLIC_DEV_TEST_PASSWORD=TestPass123!

# --- Optional overrides ---

# Overrides the API base URL. Left unset the app derives it from __DEV__
# (see src/config/api.ts), which is what production relies on.
# EXPO_PUBLIC_API_BASE_URL=

# EAS project id for push notifications; normally read from app.json extra.
# EXPO_PUBLIC_EAS_PROJECT_ID=
